<Window x:Class="Pixo.UI.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Pixo.UI"
        Title="Pixo" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Deactivated="OnDeactivated">
    <Border Margin="12" Background="{StaticResource PixoLayer}" BorderBrush="{StaticResource PixoStroke}"
            BorderThickness="1" CornerRadius="8" Padding="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
        </Border.Effect>
        <StackPanel>
            <!-- status -->
            <Grid Margin="12,12,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="LogoImage" Width="36" Height="36" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Pixo" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource PixoText2}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ScreenText" Margin="12,0,12,8" FontSize="12" Foreground="{StaticResource PixoText3}" />

            <!-- controles -->
            <Grid Margin="8,0,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Margin="4" HorizontalAlignment="Stretch" ToolTip="Tela anterior" Click="OnPrev">
                    <local:PixoIcon Kind="prev" Width="16" Height="16" />
                </ui:Button>
                <ui:Button Grid.Column="1" Margin="4" HorizontalAlignment="Stretch" Click="OnPause" x:Name="PauseButton">
                    <local:PixoIcon x:Name="PauseIcon" Kind="pause" Width="16" Height="16" />
                </ui:Button>
                <ui:Button Grid.Column="2" Margin="4" HorizontalAlignment="Stretch" ToolTip="Próxima tela" Click="OnNext">
                    <local:PixoIcon Kind="next" Width="16" Height="16" />
                </ui:Button>
            </Grid>

            <!-- brilho -->
            <Grid Margin="16,4,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <local:PixoIcon Kind="sun" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Brightness}" VerticalAlignment="Center"
                        IsMoveToPointEnabled="True" />
                <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0:0}%}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontSize="12" />
            </Grid>

            <Border Height="1" Background="{StaticResource PixoStroke}" Margin="0,0,0,4" />

            <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Padding="12,8" Margin="0,2" Click="OnCarinho">
                <StackPanel Orientation="Horizontal">
                    <local:PixoIcon Kind="heart" Width="16" Height="16" Margin="0,0,10,0" />
                    <TextBlock Text="Fazer carinho nos bichinhos" />
                </StackPanel>
            </ui:Button>
            <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Padding="12,8" Margin="0,2" Click="OnSettings">
                <StackPanel Orientation="Horizontal">
                    <local:PixoIcon Kind="sliders" Width="16" Height="16" Margin="0,0,10,0" />
                    <TextBlock Text="Abrir configurações" />
                </StackPanel>
            </ui:Button>
            <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Padding="12,8" Margin="0,2,0,2" Click="OnExit">
                <StackPanel Orientation="Horizontal">
                    <local:PixoIcon Kind="power" Width="16" Height="16" Margin="0,0,10,0" />
                    <TextBlock Text="Sair do Pixo" />
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Border>
</Window>
